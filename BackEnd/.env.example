# ========================================================
# MAPA MARCIANO - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ========================================================

# Base de Datos MySQL (Docker)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mapa_marciano
DB_USER=root
DB_PASSWORD=root_password

# Servidor Backend (Node.js + Express)
PORT=4000

# Orígenes autorizados separados por coma. Use * solo durante desarrollo.
# Ejemplo: https://ashy-dune-0d195cd10.6.azurestaticapps.net,http://localhost:5173
CORS_ORIGINS=*
